c:Tc40,{"@context":"https://schema.org","@type":"Product","name":"A100 AI家庭看护助手","description":"端侧本地 AI 家庭看护设备，覆盖宝宝、老人、父母与全家 19 个主动看护场景，核心识别与判断在设备本地完成。","brand":{"@type":"Brand","name":"A100"},"category":"家庭智能看护设备","additionalProperty":[{"@type":"PropertyValue","name":"AI夜间守护","value":"蒙面立即报警：识别口鼻被遮挡，立即报警提醒父母"},{"@type":"PropertyValue","name":"AI磕碰预警","value":"预测运动路线，提前提醒：判断即将磕碰，马上语音提醒家长"},{"@type":"PropertyValue","name":"AI保姆看护","value":"AI持续看护互动过程：哭闹无人回应、剧烈拉拽推搡等异常，立即通知父母"},{"@type":"PropertyValue","name":"AI成长记录","value":"AI主动记录成长日常：哭闹、欢笑、撑爬、吃饭，自动整理并同步微信"},{"@type":"PropertyValue","name":"AI吃药守护","value":"到点主动确认：先提醒老人，未确认再通知家人"},{"@type":"PropertyValue","name":"AI用药助手","value":"对着药盒问，马上说明白：「药盒标注：一次 1 片；请按医嘱服用」"},{"@type":"PropertyValue","name":"AI京剧陪练","value":"边唱边练，随时出声指导：「这一句尾音再收稳，兰花指再抬高一点」"},{"@type":"PropertyValue","name":"AI日常关照","value":"看懂日常规律，不对劲主动说：「奶奶今天到 10 点还没起身，比平时晚了 3 个多小时」"},{"@type":"PropertyValue","name":"AI老人守护","value":"发现倒地立即询问：持续无人回应，马上联系预设家人"},{"@type":"PropertyValue","name":"AI饮食照应","value":"手抬起来的时候就提一句：「爸的血压这周偏高，这盘先少放一勺盐」"},{"@type":"PropertyValue","name":"AI做菜辅助","value":"开口一问，直接告诉你：「这锅先放 1 茶匙糖，尝味后再调整」"},{"@type":"PropertyValue","name":"AI离家巡检","value":"全屋状态一次确认：门锁、门窗、家电，出门自动检查"},{"@type":"PropertyValue","name":"AI视觉找物","value":"问一句就能找到：「遥控器最后放在沙发右边了」"},{"@type":"PropertyValue","name":"AI出门提醒","value":"走到门口主动提醒：「你的工牌还放在茶几上」"},{"@type":"PropertyValue","name":"AI宠物看护","value":"拆家刚有苗头，马上叫停：AI 现场语音制止，同时通知主人"},{"@type":"PropertyValue","name":"AI宠物互动","value":"叫声 + 行为，越看越懂它：「在阳台门口短叫又扒门，是想出去晒太阳」"},{"@type":"PropertyValue","name":"AI晾晒提醒","value":"天气 + 阳台画面综合判断：确认将下雨且衣被未收，立即提醒家人"},{"@type":"PropertyValue","name":"AI异常巡查","value":"第二天主动提醒，时间地点都说清：「凌晨 2:14，陌生人在入户门外停留 3 分钟，两次触碰门把手」"},{"@type":"PropertyValue","name":"AI家庭巡防","value":"摄像头持续看护：发现火苗或门窗异常，立即报警并通知家人"}]}1:["$","$Lb",null,{"children":["$","main",null,{"className":"shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$c"}}],["$","header",null